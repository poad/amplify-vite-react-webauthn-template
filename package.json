{
  "name": "amplify-vite-react-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "oxlint --max-warnings 0",
    "lint-fix": "oxlint --max-warnings 0 --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.7",
    "aws-amplify": "^6.22.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@aws-amplify/ui": "^6.15.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "aws-cdk": "^2.1148.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    }
  },
  "engines": {
    "npm": "use pnpm please!",
    "yarn": "use pnpm please!"
  }
}
